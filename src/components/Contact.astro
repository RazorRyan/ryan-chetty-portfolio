---
import { siteConfig } from '@/config/site';
import SectionTitle from './SectionTitle.astro';
---

<section id="contact" class="section-card">
  <SectionTitle
    title="Start a New Mission"
    subtitle="Open to software engineering leadership and architecture-focused opportunities."
    tag="FINAL QUEST"
    color="magenta"
  />

  <div class="grid gap-6 lg:grid-cols-2">
    <!-- NPC Dialog / Quick links -->
    <div class="space-y-4">
      <!-- NPC dialog box -->
      <div class="dialog-box">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded border border-neon-magenta/30 bg-neon-magenta/8 text-xl">
            🤖
          </div>
          <div>
            <p class="pixel-label-sm text-neon-magenta">NPC: RYAN_BOT</p>
            <p class="pixel-label-xs text-slate-500">Tech Lead · South Africa</p>
          </div>
        </div>
        <p class="text-sm leading-7 text-slate-300">
          "Greetings, traveller! I see you have made it to the final quest.
          Whether you have a challenging mission, a leadership role, or an
          interesting project — I am ready to join your party."
        </p>
        <span class="cursor-blink text-neon-magenta" aria-hidden="true">▮</span>
      </div>

      <!-- Quick link actions -->
      <div class="space-y-2">
        <p class="pixel-label text-slate-500" style="font-size:0.42rem;">CHOOSE YOUR ACTION</p>

        <a class="link-pill w-full justify-start" href={`mailto:${siteConfig.email}`}>
          <span aria-hidden="true">✉️</span>
          <span>Send Email: {siteConfig.email}</span>
        </a>

        {/* Links use href="#" as safe placeholders; real URLs are set by JS below (light obfuscation). */}
        <a id="linkedin-link" class="link-pill w-full justify-start" href="#" target="_blank" rel="noreferrer">
          <span aria-hidden="true">🔗</span>
          <span>Connect on LinkedIn</span>
        </a>

        <a id="github-link" class="link-pill w-full justify-start" href="#" target="_blank" rel="noreferrer">
          <span aria-hidden="true">💻</span>
          <span>View GitHub Profile</span>
        </a>
      </div>

      <!-- Status badge -->
      <div class="flex items-center gap-3 rounded border border-neon-green/20 bg-neon-green/5 px-4 py-3">
        <span class="inline-block h-2 w-2 animate-pulse rounded-full bg-neon-green shadow-neon-green"></span>
        <span class="text-sm font-medium text-neon-green">Available for new opportunities</span>
      </div>
    </div>

    <!-- Contact form styled as quest submission -->
    <div>
      <div class="rounded border border-neon-cyan/15 bg-arcade-black/50 p-5">
        <p class="pixel-label-sm mb-4 text-neon-cyan">
          ► SUBMIT QUEST REQUEST
        </p>

        <form id="contact-form" class="space-y-3">
          <input type="hidden" name="_captcha" value="false" />

          <div>
            <label class="mb-1 block text-xs font-medium text-slate-400" for="name">Name</label>
            <input
              id="name" name="name" type="text" required
              class="arcade-input"
              placeholder="Your name"
            />
          </div>

          <div>
            <label class="mb-1 block text-xs font-medium text-slate-400" for="email">Email</label>
            <input
              id="email" name="email" type="email" required
              class="arcade-input"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label class="mb-1 block text-xs font-medium text-slate-400" for="subject">Subject</label>
            <input
              id="subject" name="subject" type="text" required
              class="arcade-input"
              placeholder="Quest title"
            />
          </div>

          <div>
            <label class="mb-1 block text-xs font-medium text-slate-400" for="message">Message</label>
            <textarea
              id="message" name="message" rows="4" required
              class="arcade-input resize-none"
              placeholder="Describe your mission or opportunity…"
            ></textarea>
          </div>

          <div
            id="form-status"
            class="hidden rounded px-4 py-2 text-sm font-medium"
            role="alert"
            aria-live="polite"
          ></div>

          <button
            id="submit-btn"
            type="submit"
            class="btn-arcade btn-arcade-pixel w-full justify-center"
          >
            ► SEND MESSAGE
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Light obfuscation only — prevents full URLs from appearing in static HTML.
  const profileLinks: Record<string, string[]> = {
    'github-link': ['https://', 'git', 'hub.com/', 'RazorRyan'],
    'linkedin-link': ['https://', 'www.', 'linkedin.com/in/', 'ryan-chetty-89121865/'],
  };

  Object.entries(profileLinks).forEach(([id, parts]) => {
    const el = document.getElementById(id) as HTMLAnchorElement | null;
    if (el) el.href = parts.join('');
  });

  // Contact form — FormSubmit AJAX
  const endpoint = ['https://formsubmit.co/ajax/', 'ryan', '.chetty16', '@gmail.com'].join('');

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status') as HTMLElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  function showStatus(message: string, success: boolean) {
    if (!statusEl) return;
    statusEl.textContent = message;
    statusEl.className = [
      'rounded px-4 py-2 text-sm font-medium',
      success
        ? 'bg-neon-green/10 border border-neon-green/30 text-neon-green'
        : 'bg-neon-magenta/10 border border-neon-magenta/30 text-neon-magenta',
    ].join(' ');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    submitBtn.disabled = true;
    submitBtn.textContent = '► SENDING…';
    if (statusEl) statusEl.className = 'hidden';

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = await res.json();
      if (data.success === 'true') {
        showStatus('✅ Quest submitted! I’ll respond soon.', true);
        form.reset();
      } else {
        showStatus('❌ Something went wrong. Please email me directly.', false);
      }
    } catch {
      showStatus('❌ Network error. Please try again or email me directly.', false);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '► SEND MESSAGE';
    }
  });
</script>
