---
import SectionTitle from './SectionTitle.astro';

const levels = [
  {
    number: '01',
    title: 'Enterprise Platform Initiative',
    genre: 'Boss Battle',
    difficulty: 4,
    description:
      'Designing and delivering a large-scale enterprise platform with a focus on system architecture, reliability, and measured delivery outcomes.',
    stack: ['Architecture', 'Backend', 'Cloud', 'Team Leadership'],
    status: 'COMPLETED',
    statusColor: 'green',
  },
  {
    number: '02',
    title: 'AI-Enabled Solution Delivery',
    genre: 'Side Quest',
    difficulty: 3,
    description:
      'Applying AI tooling and LLM-driven patterns to solve complex domain and operational challenges in enterprise systems.',
    stack: ['AI/ML Integration', 'APIs', 'Backend Engineering'],
    status: 'IN PROGRESS',
    statusColor: 'yellow',
  },
  {
    number: '03',
    title: 'Game Development / Tech Experiments',
    genre: 'Free Roam',
    difficulty: 2,
    description:
      'Selected side-projects and prototypes blending game development with engineering depth — where creativity meets technical craft.',
    stack: ['Game Dev', 'Prototyping', 'Creative Engineering'],
    status: 'ONGOING',
    statusColor: 'cyan',
  },
];

const difficultyStars = (n: number, max = 5) =>
  '★'.repeat(n) + '☆'.repeat(max - n);

const statusStyles: Record<string, string> = {
  green:  'border-neon-green/40 bg-neon-green/8 text-neon-green',
  yellow: 'border-neon-yellow/40 bg-neon-yellow/8 text-neon-yellow',
  cyan:   'border-neon-cyan/40 bg-neon-cyan/8 text-neon-cyan',
};
---

<section id="projects" class="section-card">
  <SectionTitle
    title="Featured Levels"
    subtitle="Select a mission — each level represents a domain of engineering impact."
    tag="LEVEL SELECT"
    color="yellow"
  />

  <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {levels.map((level) => (
      <article class="level-card group">
        <!-- Level header -->
        <div class="mb-3 flex items-start justify-between gap-2">
          <div class="flex items-center gap-2">
            <span
              class="pixel-label flex h-8 w-8 shrink-0 items-center justify-center rounded border border-neon-cyan/30 bg-neon-cyan/10 text-neon-cyan"
              style="font-size:0.5rem;"
            >
              {level.number}
            </span>
            <div>
              <p class="pixel-label-xs text-slate-500">{level.genre}</p>
            </div>
          </div>
          <span
            class:list={[
              'pixel-label-xs shrink-0 rounded border px-2 py-1',
              statusStyles[level.statusColor] ?? statusStyles.cyan,
            ]}
          >
            {level.status}
          </span>
        </div>

        <!-- Title -->
        <h3 class="mb-2 font-bold text-slate-100 transition-colors group-hover:text-neon-cyan">
          {level.title}
        </h3>

        <!-- Difficulty -->
        <p class="mb-3 text-xs text-neon-yellow" aria-label={`Difficulty: ${level.difficulty} out of 5`}>
          {difficultyStars(level.difficulty)}
        </p>

        <!-- Description -->
        <p class="mb-4 text-sm leading-6 text-slate-400">{level.description}</p>

        <!-- Stack badges -->
        <div class="flex flex-wrap gap-1.5">
          {level.stack.map((tag) => (
            <span class="skill-badge text-xs">{tag}</span>
          ))}
        </div>
      </article>
    ))}
  </div>

  <p class="mt-5 text-center text-xs text-slate-500">
    More levels incoming — real project case studies will be added once verified.
  </p>
</section>
