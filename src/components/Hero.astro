---
import { siteConfig, githubProfileImageUrl } from '@/config/site';

const mainTagline =
  'Technical Lead focused on building scalable, high-quality software systems with a strong emphasis on architecture and clean design.';
const gameLevelLabel = 'Level 99 Builder';
const titleSeparator = '•';
---

<section class="grid gap-8 py-10 md:grid-cols-[1.15fr,0.85fr] md:items-center md:py-16" id="home">
  <div class="space-y-5">
    <p
      aria-label={`Player profile. Based in ${siteConfig.location}.`}
      class="inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-100/80 px-3 py-1 text-sm font-semibold text-brand-700 dark:border-brand-800 dark:bg-brand-900/40 dark:text-brand-300"
    >
      <span>Player Profile</span>
      <span aria-hidden="true">•</span>
      <span>Based in {siteConfig.location}</span>
    </p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
      {siteConfig.fullName}
    </h1>
    <p class="text-xl font-semibold text-slate-700 dark:text-slate-200">
      <span>{siteConfig.title}</span>
      <span aria-hidden="true" class="px-2">
        {titleSeparator}
      </span>
      <span>{gameLevelLabel}</span>
    </p>
    <p class="max-w-2xl text-base leading-7 text-slate-600 dark:text-slate-300">{mainTagline}</p>

    <div class="grid gap-2 pt-2 sm:grid-cols-2">
      <a href="#about" class="quest-chip">
        <span aria-hidden="true">🧭</span>
        <span>Start Quest: About</span>
      </a>
      <a href="#skills" class="quest-chip">
        <span aria-hidden="true">⚔️</span>
        <span>Unlock Skills</span>
      </a>
      <a href="#experience" class="quest-chip">
        <span aria-hidden="true">🏆</span>
        <span>View Achievements</span>
      </a>
      <a href="#contact" class="quest-chip">
        <span aria-hidden="true">📨</span>
        <span>Send a Message</span>
      </a>
    </div>
  </div>

  <div class="mx-auto w-full max-w-sm">
    <div id="game-panel" class="game-panel section-card relative overflow-hidden p-6">
      <div class="glow-orb absolute -right-12 -top-12 h-36 w-36 rounded-full bg-brand-500/20 blur-3xl"></div>
      <div class="glow-orb absolute -left-10 bottom-0 h-24 w-24 rounded-full bg-cyan-400/20 blur-3xl"></div>
      <img
        src={githubProfileImageUrl}
        alt={`GitHub profile photo of ${siteConfig.fullName}`}
        loading="eager"
        class="mx-auto aspect-square w-52 rounded-2xl border border-slate-200 object-cover shadow-lg transition-transform duration-300 dark:border-slate-700"
      />
      <div class="mt-5 space-y-3 rounded-xl border border-slate-200/80 bg-white/80 p-4 dark:border-slate-700 dark:bg-slate-900/80">
        <p id="xp-status" aria-live="polite" aria-atomic="true" class="text-sm font-semibold text-slate-700 dark:text-slate-200">
          🎮 Side Quest: Gain XP
        </p>
        <div class="h-2 overflow-hidden rounded-full bg-slate-200 dark:bg-slate-700">
          <div id="xp-fill" class="h-full w-0 rounded-full bg-gradient-to-r from-brand-500 to-cyan-400 transition-all duration-300"></div>
        </div>
        <div class="flex items-center justify-between text-xs text-slate-600 dark:text-slate-300">
          <span id="xp-level">XP: 0 / 100</span>
          <span>Tap to level up</span>
        </div>
        <button
          id="xp-button"
          type="button"
          aria-label="Gain XP. Current XP is 0 out of 100."
          class="w-full rounded-full bg-brand-600 px-4 py-2 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-brand-500"
        >
          +10 XP
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const MAX_XP = 100;
  const XP_INCREMENT = 10;
  const PANEL_PERSPECTIVE = 800;
  const MAX_TILT_ANGLE = 6;
  const ROTATION_PRECISION = 2;
  let xp = 0;

  const xpButton = document.getElementById('xp-button');
  const xpFill = document.getElementById('xp-fill');
  const xpLevel = document.getElementById('xp-level');
  const xpStatus = document.getElementById('xp-status');
  const gamePanel = document.getElementById('game-panel');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const updateXp = () => {
    if (!xpFill || !xpLevel || !xpStatus) return;
    xpFill.style.width = `${xp}%`;
    xpLevel.textContent = `XP: ${xp} / ${MAX_XP}`;
    xpStatus.textContent = xp >= MAX_XP ? '✨ Quest Complete! Contact Ryan to collaborate.' : '🎮 Side Quest: Gain XP';
    if (xpButton instanceof HTMLButtonElement) {
      xpButton.setAttribute('aria-label', `Gain XP. Current XP is ${xp} out of ${MAX_XP}.`);
    }
  };

  xpButton?.addEventListener('click', () => {
    xp = Math.min(MAX_XP, xp + XP_INCREMENT);
    updateXp();
  });

  if (!prefersReducedMotion) {
    let rafHandle = 0;
    let targetX = 0;
    let targetY = 0;

    gamePanel?.addEventListener('mousemove', (event) => {
      const target = event.currentTarget;
      if (!(target instanceof HTMLElement)) return;
      const rect = target.getBoundingClientRect();
      targetX = ((event.clientY - rect.top) / rect.height - 0.5) * -MAX_TILT_ANGLE;
      targetY = ((event.clientX - rect.left) / rect.width - 0.5) * MAX_TILT_ANGLE;

      if (rafHandle !== 0) return;
      rafHandle = window.requestAnimationFrame(() => {
        target.style.transform = `perspective(${PANEL_PERSPECTIVE}px) rotateX(${targetX.toFixed(ROTATION_PRECISION)}deg) rotateY(${targetY.toFixed(ROTATION_PRECISION)}deg)`;
        rafHandle = 0;
      });
    });

    gamePanel?.addEventListener('mouseleave', (event) => {
      const target = event.currentTarget;
      if (!(target instanceof HTMLElement)) return;
      target.style.transform = `perspective(${PANEL_PERSPECTIVE}px) rotateX(0deg) rotateY(0deg)`;
    });
  }
</script>
