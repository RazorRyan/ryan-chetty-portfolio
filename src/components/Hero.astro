---
import { siteConfig, githubProfileImageUrl } from '@/config/site';

const PLAYER_LEVEL = 99;
const MAX_XP = 100;
const XP_INCREMENT = 10;
---

<section
  id="home"
  class="relative grid gap-8 py-10 md:grid-cols-[1.25fr,0.75fr] md:items-center md:py-16"
>
  <!-- ▸ Left column — identity & actions -->
  <div class="space-y-6">
    <!-- INSERT COIN badge -->
    <div class="flex items-center gap-3">
      <span class="pixel-label-md inline-flex items-center gap-2 rounded border border-neon-cyan/30 bg-neon-cyan/5 px-2.5 py-1.5 text-neon-cyan">
        ★ INSERT COIN ★
      </span>
      <span class="pixel-label-sm text-slate-500">
        {siteConfig.location}
      </span>
    </div>

    <!-- Player name -->
    <div class="space-y-2">
      <p class="pixel-label-md text-neon-cyan">
        PLAYER 1
      </p>
      <h1 class="text-5xl font-black tracking-tight text-slate-100 sm:text-6xl lg:text-7xl">
        {siteConfig.fullName}
      </h1>
    </div>

    <!-- Title & level -->
    <div class="flex flex-wrap items-center gap-3">
      <span class="text-lg font-semibold text-slate-300 sm:text-xl">
        {siteConfig.title}
      </span>
      <span class="pixel-label-sm rounded bg-neon-yellow/10 px-2 py-1 text-neon-yellow">
        LVL {PLAYER_LEVEL}
      </span>
    </div>

    <!-- Tagline -->
    <p class="max-w-xl text-base leading-7 text-slate-400">
      {siteConfig.coreBio}
    </p>

    <!-- Quest navigation buttons -->
    <div class="grid grid-cols-2 gap-2 pt-1 sm:grid-cols-4">
      <a href="#about" class="quest-chip justify-center">
        <span aria-hidden="true">📊</span>
        <span>Stats</span>
      </a>
      <a href="#skills" class="quest-chip justify-center">
        <span aria-hidden="true">⚔️</span>
        <span>Skills</span>
      </a>
      <a href="#projects" class="quest-chip justify-center">
        <span aria-hidden="true">🗺️</span>
        <span>Levels</span>
      </a>
      <a href="#contact" class="quest-chip justify-center">
        <span aria-hidden="true">📨</span>
        <span>Contact</span>
      </a>
    </div>

    <!-- PRESS START CTA -->
    <div class="pt-2">
      <a href="#about" class="btn-arcade btn-arcade-pixel inline-flex">
        ▶ PRESS START
        <span class="cursor-blink ml-1" aria-hidden="true">_</span>
      </a>
    </div>
  </div>

  <!-- ▸ Right column — HUD/profile card -->
  <div class="mx-auto w-full max-w-xs">
    <div
      id="game-panel"
      class="game-panel scanlines section-card overflow-hidden"
      style="background: rgba(8,8,40,0.96); border-color: rgba(0,245,255,0.28);"
    >
      <!-- Floating glow orbs -->
      <div class="glow-orb pointer-events-none absolute -right-10 -top-10 h-32 w-32 rounded-full bg-neon-cyan/10 blur-3xl"></div>
      <div class="glow-orb pointer-events-none absolute -bottom-8 -left-8 h-24 w-24 rounded-full bg-neon-purple/10 blur-3xl" style="animation-delay:-2s;"></div>

      <!-- HUD header -->
      <div class="mb-4 flex items-center justify-between">
        <span class="pixel-label-sm text-neon-cyan">PLAYER PROFILE</span>
        <span class="pixel-label-sm text-neon-yellow">◆ LVL {PLAYER_LEVEL}</span>
      </div>

      <!-- Avatar -->
      <div class="relative mx-auto w-fit">
        <div class="absolute inset-0 rounded-xl bg-neon-cyan/10 blur-lg"></div>
        <img
          src={githubProfileImageUrl}
          alt={`GitHub profile photo of ${siteConfig.fullName}`}
          loading="eager"
          class="relative mx-auto aspect-square w-44 rounded-xl border border-neon-cyan/20 object-cover shadow-lg"
        />
      </div>

      <!-- XP mini-game -->
      <div class="mt-4 space-y-3 rounded border border-neon-cyan/15 bg-arcade-black/60 p-3">
        <p
          id="xp-status"
          aria-live="polite"
          aria-atomic="true"
          class="pixel-label-sm text-slate-300"
        >
          ★ SIDE QUEST: GAIN XP
        </p>

        <div class="stat-bar-track">
          <div id="xp-fill" class="stat-bar-fill" style="width:0%"></div>
        </div>

        <div class="flex items-center justify-between">
          <span
            id="xp-level"
            class="pixel-label-xs text-neon-cyan"
          >XP: 0 / {MAX_XP}</span>
          <span class="pixel-label-xs text-slate-500">TAP TO LEVEL UP</span>
        </div>

        <button
          id="xp-button"
          type="button"
          aria-label={`Gain XP. Current XP is 0 out of ${MAX_XP}.`}
          class="btn-arcade btn-arcade-pixel w-full justify-center"
          style="padding:0.5rem 0.75rem;"
        >
          +{XP_INCREMENT} XP
        </button>
      </div>

      <!-- Health/Status bars -->
      <div class="mt-3 space-y-2">
        <div class="flex items-center justify-between text-xs">
          <span class="pixel-label-xs text-slate-400">AVAILABILITY</span>
          <span class="pixel-label-xs text-neon-green">OPEN</span>
        </div>
        <div class="stat-bar-track">
          <div class="stat-bar-fill stat-bar-fill-green" style="width:85%;"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const MAX_XP = 100;
  const XP_INCREMENT = 10;
  const PANEL_PERSPECTIVE = 800;
  const MAX_TILT_ANGLE = 6;
  const ROTATION_PRECISION = 2;
  let xp = 0;

  const xpButton = document.getElementById('xp-button');
  const xpFill = document.getElementById('xp-fill');
  const xpLevel = document.getElementById('xp-level');
  const xpStatus = document.getElementById('xp-status');
  const gamePanel = document.getElementById('game-panel');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const updateXp = () => {
    if (!xpFill || !xpLevel || !xpStatus) return;
    xpFill.style.width = `${xp}%`;
    xpLevel.textContent = `XP: ${xp} / ${MAX_XP}`;
    if (xp >= MAX_XP) {
      xpStatus.textContent = '★ QUEST COMPLETE! CONTACT RYAN.';
      xpStatus.style.color = '#ffd700';
    } else {
      xpStatus.textContent = '★ SIDE QUEST: GAIN XP';
      xpStatus.style.color = '';
    }
    if (xpButton instanceof HTMLButtonElement) {
      xpButton.setAttribute('aria-label', `Gain XP. Current XP is ${xp} out of ${MAX_XP}.`);
    }
  };

  xpButton?.addEventListener('click', () => {
    xp = Math.min(MAX_XP, xp + XP_INCREMENT);
    updateXp();
  });

  if (!prefersReducedMotion) {
    let tiltAnimationId: number | null = null;
    let targetX = 0;
    let targetY = 0;

    gamePanel?.addEventListener('mousemove', (event) => {
      const target = event.currentTarget;
      if (!(target instanceof HTMLElement)) return;
      const rect = target.getBoundingClientRect();
      targetX = ((event.clientY - rect.top) / rect.height - 0.5) * -MAX_TILT_ANGLE;
      targetY = ((event.clientX - rect.left) / rect.width - 0.5) * MAX_TILT_ANGLE;

      if (tiltAnimationId !== null) return;
      tiltAnimationId = window.requestAnimationFrame(() => {
        target.style.transform = `perspective(${PANEL_PERSPECTIVE}px) rotateX(${targetX.toFixed(ROTATION_PRECISION)}deg) rotateY(${targetY.toFixed(ROTATION_PRECISION)}deg)`;
        tiltAnimationId = null;
      });
    });

    gamePanel?.addEventListener('mouseleave', (event) => {
      const target = event.currentTarget;
      if (!(target instanceof HTMLElement)) return;
      target.style.transform = `perspective(${PANEL_PERSPECTIVE}px) rotateX(0deg) rotateY(0deg)`;
    });
  }
</script>
